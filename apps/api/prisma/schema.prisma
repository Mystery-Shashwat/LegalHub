generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ────────────────────────────────────
enum Role {
  ADMIN
  LAWYER
  CLIENT
}

enum LawyerStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  CLOSED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum LawyerPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

// ─── USER (base for all 3 roles) ──────────────
model User {
  id               String   @id @default(cuid())
  email            String   @unique
  phone            String?  @unique
  name             String
  passwordHash     String
  role             Role     @default(CLIENT)
  avatar           String?
  isEmailVerified  Boolean  @default(false)
  isPhoneVerified  Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lawyerProfile    LawyerProfile?
  clientProfile    ClientProfile?
  bookingsAsClient Booking[]  @relation("ClientBookings")
  reviewsGiven     Review[]   @relation("ReviewsByClient")
  sentMessages     Message[]  @relation("SentMessages")
  refreshTokens    RefreshToken[]
  disputes         Dispute[]  @relation("UserDisputes")
  forumQuestions   ForumQuestion[]  @relation("UserQuestions")
  forumAnswers     ForumAnswer[]    @relation("UserAnswers")
  rtiApplications  RTIApplication[] @relation("UserRTIs")
  templatePurchases TemplatePurchase[]

  // Referrals
  referralCode     String   @unique @default(cuid())
  referredById     String?
  referredBy       User?    @relation("UserReferrals", fields: [referredById], references: [id])
  referrals        User[]   @relation("UserReferrals")
  walletBalance    Float    @default(0)
  referralRewards  ReferralReward[] @relation("RewardReferrer")
  notifications    Notification[]   @relation("UserNotifications")
  passwordResets   PasswordReset[]  @relation("UserPasswordResets")
  blogs            Blog[]           @relation("UserBlogs")
  blogComments     BlogComment[]    @relation("UserBlogComments")
  otpCodes         OTPCode[]        @relation("UserOTPCodes")
}

// ─── CLIENT PROFILE ───────────────────────────
model ClientProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      String?
  state     String?
  about     String? // brief legal need description
}

// ─── LAWYER PROFILE (all professional fields) ─
model LawyerProfile {
  id                      String       @id @default(cuid())
  userId                  String       @unique
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  barCouncilNumber        String       @unique
  barCouncilState         String
  enrollmentYear          Int
  degreeCollege           String?
  degreeYear              Int?

  specializations         String[]     // ["Criminal Law", "Family Law"]
  courtsOfPractice        String[]
  experienceYears         Int          @default(0)
  bio                     String?
  city                    String
  state                   String
  languages               String[]
  hourlyRate              Float
  freeConsultation        Boolean      @default(false)
  freeConsultMinutes      Int          @default(0)

  status                  LawyerStatus @default(PENDING)
  rejectionReason         String?
  verifiedAt              DateTime?
  verifiedByAdminId       String?

  certificateOfPracticeUrl String?    // bar council cert
  degreeDocumentUrl        String?    // LLB/LLM degree
  govtIdUrl                String?    // Aadhaar/PAN
  profilePhotoUrl          String?

  avgRating               Float        @default(0)
  totalReviews            Int          @default(0)
  linkedinUrl             String?
  websiteUrl              String?

  // Subscription plan
  plan                    LawyerPlan   @default(FREE)
  planExpiresAt           DateTime?

  bookings                Booking[]    @relation("LawyerBookings")
  reviews                 Review[]     @relation("LawyerReviews")
  availability            Availability[]
  cases                   Case[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

// ─── REFRESH TOKEN ─────────────────────────────
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── AVAILABILITY SLOTS ────────────────────────
model Availability {
  id              String       @id @default(cuid())
  lawyerProfileId String
  lawyer          LawyerProfile @relation(fields: [lawyerProfileId], references: [id])
  dayOfWeek       Int          // 0=Sun … 6=Sat
  startTime       String       // "09:00"
  endTime         String       // "18:00"
  isActive        Boolean      @default(true)
}

// ─── BOOKING ───────────────────────────────────
model Booking {
  id              String        @id @default(cuid())
  clientId        String
  lawyerProfileId String
  client          User          @relation("ClientBookings", fields: [clientId], references: [id])
  lawyer          LawyerProfile @relation("LawyerBookings", fields: [lawyerProfileId], references: [id])
  scheduledAt     DateTime
  durationMinutes Int           @default(60)
  status          BookingStatus @default(PENDING)
  type            String        @default("video") // video | chat | in-person
  amount          Float
  isPaid          Boolean       @default(false)
  paymentId       String?
  meetingUrl      String?
  clientNotes     String?
  createdAt       DateTime      @default(now())
  payment         Payment?
  review          Review?
  dispute         Dispute?
  case            Case?
}

// ─── PAYMENT ───────────────────────────────────
model Payment {
  id               String        @id @default(cuid())
  bookingId        String        @unique
  booking          Booking       @relation(fields: [bookingId], references: [id])
  amount           Float
  currency         String        @default("INR")
  razorpayOrderId  String?
  razorpayPaymentId String?
  status           PaymentStatus @default(PENDING)
  commissionAmount Float         // 10% cut
  lawyerPayout     Float         // 90% to lawyer
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
}

// ─── REVIEW ────────────────────────────────────
model Review {
  id              String        @id @default(cuid())
  bookingId       String        @unique // one review per booking
  booking         Booking       @relation(fields: [bookingId], references: [id])
  clientId        String
  client          User          @relation("ReviewsByClient", fields: [clientId], references: [id])
  lawyerProfileId String
  lawyer          LawyerProfile @relation("LawyerReviews", fields: [lawyerProfileId], references: [id])
  rating          Int           // 1–5
  comment         String?
  lawyerReply     String?       // lawyer's public reply to the review
  createdAt       DateTime      @default(now())
}

// ─── CASE ──────────────────────────────────────
model Case {
  id              String        @id @default(cuid())
  bookingId       String?       @unique
  booking         Booking?      @relation(fields: [bookingId], references: [id])
  clientId        String
  lawyerProfileId String
  lawyer          LawyerProfile @relation(fields: [lawyerProfileId], references: [id])
  title           String
  description     String?
  practiceArea    String
  status          CaseStatus    @default(OPEN)
  documents       Document[]
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ─── DOCUMENT ──────────────────────────────────
model Document {
  id            String   @id @default(cuid())
  caseId        String
  case          Case     @relation(fields: [caseId], references: [id])
  name          String
  url           String   // R2 URL
  fileType      String
  sizeBytes     Int
  uploadedBy    String   // userId
  
  // E-Signature Audit Fields
  signatureHash String?  // SHA-256 hash of signature + document
  signedAt      DateTime?
  signerIp      String?
  signerId      String?  // The user who signed it
  
  createdAt     DateTime @default(now())
}

// ─── MESSAGE ───────────────────────────────────
model Message {
  id             String   @id @default(cuid())
  conversationId String   // format: "userId1_userId2" (sorted)
  senderId       String
  sender         User     @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  fileUrl        String?
  readAt         DateTime?
  createdAt      DateTime @default(now())
  @@index([conversationId])
}

// ─── DISPUTE ───────────────────────────────────
model Dispute {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("UserDisputes", fields: [userId], references: [id])
  bookingId   String?       @unique
  booking     Booking?      @relation(fields: [bookingId], references: [id])
  reason      String
  description String?
  status      DisputeStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ─── FORUM ─────────────────────────────────────
model ForumQuestion {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation("UserQuestions", fields: [authorId], references: [id])
  title       String
  content     String
  category    String
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  answers     ForumAnswer[]
}

model ForumAnswer {
  id          String   @id @default(cuid())
  questionId  String
  question    ForumQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("UserAnswers", fields: [authorId], references: [id])
  content     String
  upvotes     Int      @default(0)
  isAccepted  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── RTI APPLICATION ───────────────────────────
model RTIApplication {
  id              String   @id @default(cuid())
  applicantId     String
  applicant       User     @relation("UserRTIs", fields: [applicantId], references: [id])
  authorityName   String
  subject         String
  description     String
  status          String   @default("DRAFT") // DRAFT, SUBMITTED
  filedAt         DateTime?
  documentUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── DOCUMENT TEMPLATES ────────────────────────
model DocumentTemplate {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  category    String   // "Business", "Real Estate", "Personal"
  fileUrl     String   // Link to the actual template file
  previewUrl  String?  // Blurred preview image
  downloads   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases   TemplatePurchase[]
}

model TemplatePurchase {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  templateId  String
  template    DocumentTemplate @relation(fields: [templateId], references: [id])
  amountPaid  Float
  status      PaymentStatus @default(PENDING)
  paymentId   String?
  createdAt   DateTime @default(now())
}

// ─── REFERRALS ─────────────────────────────────
model ReferralReward {
  id              String   @id @default(cuid())
  referrerId      String
  referrer        User     @relation("RewardReferrer", fields: [referrerId], references: [id])
  referredUserId  String   @unique // only one reward per referred user
  amount          Float
  reason          String
  createdAt       DateTime @default(now())
}

// ─── NOTIFICATIONS ─────────────────────────────
enum NotifType {
  BOOKING
  PAYMENT
  MESSAGE
  CASE
  REVIEW
  REFERRAL
  SYSTEM
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      NotifType @default(SYSTEM)
  title     String
  body      String
  isRead    Boolean   @default(false)
  link      String?   // e.g. /client/bookings/cly123
  createdAt DateTime  @default(now())
  @@index([userId, isRead])
}

// ─── PASSWORD RESET ────────────────────────────
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserPasswordResets", fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

// ─── BLOG ──────────────────────────────────────
model Blog {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation("UserBlogs", fields: [authorId], references: [id])
  title       String
  slug        String   @unique
  excerpt     String
  content     String   @db.Text
  category    String   @default("Legal Insights")
  tags        String[]
  coverImage  String?
  isPublished Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    BlogComment[]
  @@index([slug])
  @@index([isPublished, createdAt])
}

model BlogComment {
  id        String   @id @default(cuid())
  blogId    String
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("UserBlogComments", fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

// ─── OTP CODES (email / phone verification) ────
model OTPCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserOTPCodes", fields: [userId], references: [id], onDelete: Cascade)
  code      String
  purpose   String   // "email_verification" | "phone_verification" | "login_otp"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose])
}
